# Optional. The demo runs without keys via DuckDuckGo (ddgs) or the checked-in sample.
# If a live search backend is unavailable, the agent falls back to sample/ and does not invent articles.

# Railway / uvicorn listen port (Railway sets this; local web defaults to 8000 if unset in code paths).
# PORT=8000

# Tavily (preferred live web search): https://tavily.com
# TAVILY_API_KEY=

# Brave Search: https://brave.com/search/api/
# BRAVE_API_KEY=

# NewsAPI: https://newsapi.org
# NEWSAPI_KEY=

# Optional LLM for live claim/tone/topic labels (heuristic classifier is the default).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
